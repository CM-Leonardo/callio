{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/annotation/**",
              "components/display/**",
              "components/forms/**",
              "components/icons/**",
              "ui_kits/callio-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cousine|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Cousine, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|number|hasNumber|hasIconLeft|iconLeft|iconRight|hasText|type|hasTooltipTop|hasIconRight|status|hasTotal|variant|enabled|hasTooltipBottom|total|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, text, number, hasNumber, hasIconLeft, iconLeft, iconRight, hasText, type, hasTooltipTop, hasIconRight, status, hasTotal, variant, enabled, hasTooltipBottom, total, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:brand|danger|success)$/]",
        "message": "<Button> type must be one of 'brand' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:default|hover|pressed)$/]",
        "message": "<Button> status must be one of 'default' | 'hover' | 'pressed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|hasImage|icon|hasIcon|hasTitle|position|link|hasTag|hasDescription|title|description|hasLink|active|icon1|icon2|key|ref|className|style|children)$/]",
        "message": "<CheckBox> doesn't accept that prop. Declared props: className, style, hasImage, icon, hasIcon, hasTitle, position, link, hasTag, hasDescription, title, description, hasLink, active, icon1, icon2."
